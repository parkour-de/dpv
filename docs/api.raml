#%RAML 1.0
title: DPV API
description: API to get data about DPV
version: '1.0'
baseUri: http://localhost:8080/dpv/
mediaType: application/json
types:
  User: !include types/User.raml
  Club: !include types/Club.raml
  Membership: !include types/Membership.raml
  ErrorResponse: !include types/errorResponse.raml
  Census: !include types/Census.raml
securitySchemes:
  basicAuth:
    type: Basic Authentication

/users:
  post:
    description: Register a new user
    body:
      application/json:
        type: object
        properties:
          email: string
          password: string
          lastname: string
          firstname: string
          dateOfBirth: string
          consent_privacy: boolean
    responses:
      200:
        description: User created
        body:
          application/json:
            type: User
  /me:
    get:
      description: Get the current authenticated user
      securedBy: [ basicAuth ]
      responses:
        200:
          description: Current user details
          body:
            application/json:
              type: User

    /apply:
      post:
        description: Apply for active membership
        securedBy: [ basicAuth ]
        body:
          application/json:
            type: object
            properties:
              type?: string
              fee?: number
              consent_privacy?: boolean
              consent_accuracy?: boolean
              consent_statutes?: boolean
              consent_finances?: boolean
        responses:
          200:
            description: Application submitted
    /cancel:
      post:
        description: Cancel active membership
        securedBy: [ basicAuth ]
        responses:
          200:
            description: Membership cancelled

  /request-email-validation:
    post:
      description: Request a validation email for the user's email address. Requires authentication.
      securedBy: [ basicAuth ]
      body:
        application/json:
          type: object
          properties:
            email:
              type: string
              required: false
              description: Optional. If provided, sends validation to this email; otherwise uses user's current email.
      responses:
        200:
          description: Validation email sent
          body:
            application/json:
              type: ErrorResponse
        400:
          description: Bad request (missing/invalid data)
          body:
            application/json:
              type: ErrorResponse
  /validate-email:
    get:
      description: Validate a user's email address using query parameters from the validation link.
      queryParameters:
        key:
          type: string
          required: true
          description: User key
        expiry:
          type: string
          required: true
          description: Expiry timestamp
        email:
          type: string
          required: true
          description: Email address to validate
        token:
          type: string
          required: true
          description: Validation token
      responses:
        200:
          description: Email successfully validated (returns HTML)
          body:
            text/html:
              example: |
                <!DOCTYPE html>
                <html lang="de">
                <head>
                  <meta charset="UTF-8">
                  <title>E-Mail bestätigt - DPV</title>
                </head>
                <body>
                  <h1>✅ E-Mail-Adresse erfolgreich bestätigt!</h1>
                </body>
                </html>
        400:
          description: Bad request (missing/invalid parameters)
          body:
            application/json:
              type: ErrorResponse

  /request-password-reset:
    post:
      description: Request a password reset email for the given email address.
      body:
        application/json:
          type: object
          properties:
            email:
              type: string
              required: true
              description: The email address to send the password reset link to.
      responses:
        200:
          description: Password reset email sent
          body:
            application/json:
              type: ErrorResponse
        400:
          description: Bad request (missing/invalid data)
          body:
            application/json:
              type: ErrorResponse
  /reset-password:
    get:
      description: Show password reset HTML form. Query parameters are passed from the email link.
      queryParameters:
        key:
          type: string
          required: true
          description: User key
        expiry:
          type: string
          required: true
          description: Expiry timestamp
        token:
          type: string
          required: true
          description: Password reset token
      responses:
        200:
          description: Password reset form (HTML with JavaScript for JSON POST)
          body:
            text/html:
              example: |
                <!DOCTYPE html>
                <html lang="de">
                <head>
                  <meta charset="UTF-8">
                  <title>Passwort zurücksetzen - DPV</title>
                </head>
                <body>
                  <h1>🔒 Passwort zurücksetzen</h1>
                </body>
                </html>
        400:
          description: Bad request (missing/invalid parameters)
          body:
            application/json:
              type: ErrorResponse
    post:
      description: Handle password reset. Expects all variables as JSON in POST body.
      body:
        application/json:
          type: object
          properties:
            key:
              type: string
              required: true
            expiry:
              type: string
              required: true
            token:
              type: string
              required: true
            password:
              type: string
              required: true
            confirm:
              type: string
              required: true
      responses:
        200:
          description: Password successfully changed (returns JSON)
          body:
            application/json:
              type: ErrorResponse
        400:
          description: Bad request (missing/invalid parameters or passwords do not match)
          body:
            application/json:
              type: ErrorResponse
  get:
    description: List users. Admins see all users.
    securedBy: [ basicAuth ]
    queryParameters:
      membership_status?:
        type: string
        description: Filter by membership status
      has_club?:
        type: string
        description: Filter by presence of a vorstand edge
    responses:
      200:
        description: List of matching users
        body:
          application/json:
            type: User[]
          text/csv:
            description: CSV representation of users

/user/{key}:
  securedBy: [ basicAuth ]
  get:
    description: Get a specific user by key (Admin only)
    responses:
      200:
        description: User details
        body:
          application/json:
            type: User
  patch:
    description: Update a specific user (Admin or self)
    body:
      application/json:
        type: object
        properties:
          firstname?: string
          lastname?: string
          email?: string
          dateOfBirth?: string
    responses:
      200:
        description: User updated
        body:
          application/json:
            type: User
  /payment-details:
    get:
      description: Get payment details for a specific user
      responses:
        200:
          description: Payment details
          body:
            application/json:
              type: object
  /roles:
    patch:
      description: Update a user's roles (Admin only)
      body:
        application/json:
          type: object
          properties:
            roles:
              type: string[]
              example: ["admin", "active-admin"]
      responses:
        200:
          description: Roles updated successfully
          body:
            application/json:
              type: User
        403:
          description: Forbidden - requires global admin
  /approve:
    post:
      description: Approve user membership application (Admin only)
      body:
        application/json:
          type: object
          properties:
            begin_date?: integer
      responses:
        200:
          description: Membership approved
  /deny:
    post:
      description: Deny user membership application (Admin only)
      responses:
        200:
          description: Membership denied
  /cancel:
    post:
      description: Cancel user membership (Admin only)
      responses:
        200:
          description: Membership cancelled
/clubs:
  securedBy: [ basicAuth ]
  get:
    description: List clubs. Admins see all clubs with pagination/filtering; users see clubs they administer.
    queryParameters:
      status?:
        type: string
        description: Filter by status (inactive, requested, active, denied, cancelled)
      skip?:
        type: integer
        default: 0
      limit?:
        type: integer
        default: 100
      missing_census_year?:
        type: integer
        description: Filters returned active/canceling clubs to those lacking a census measurement for this year
    responses:
      200:
        description: List of clubs
        body:
          application/json:
            type: Club[]
          text/csv:
            description: CSV representation of clubs
  post:
    description: Create a new club
    body:
      application/json:
        type: object
        properties:
          name:
            type: string
            example: "Parkour Club e.V."
          legal_form:
            type: string
            example: "e.V."
          email:
            type: string
            required: false
            example: "info@parkour-club.de"
          address:
            type: string
            required: false
            example: "Musterstraße 1, 12345 Musterstadt"
    responses:
      200:
        description: Club created
        body:
          application/json:
            type: Club
  /search:
    get:
      description: Search for clubs (Autocomplete / Duplicate prevention)
      queryParameters:
        q:
          type: string
          required: true
          description: Search query (min 3 characters)
      responses:
        200:
          description: List of matching clubs
          body:
            application/json:
              type: Club[]

/club:
  /{key}:
    get:
      description: Get details of a specific club
      responses:
        200:
          description: Club details
          body:
            application/json:
              type: Club
        403:
          description: Unauthorized
    /active-members:
      get:
        description: Get active members of the club
        responses:
          200:
            description: List of active members
            body:
              application/json:
                type: User[]
    patch:
      description: Partially update a club details (Board members only)
      body:
        application/json:
          type: object
          properties:
            name:
              type: string
              required: false
              example: "Parkour Club e.V."
            legal_form:
              type: string
              required: false
              example: "e.V."
            email:
              type: string
              required: false
              example: "info@parkour-club.de"
            address:
              type: string
              required: false
              example: "Musterstraße 1, 12345 Musterstadt"
            contact_person:
              type: string
              required: false
              example: "Max Mustermann"
            iban:
              type: string
              required: false
            sepa_mandate_number:
              type: string
              required: false
      responses:
        200:
          description: Updated club details
          body:
            application/json:
              type: Club
    delete:
      description: Delete a club
      responses:
        204:
          description: Club deleted
    /apply:
      post:
        description: Apply for membership
        body:
          application/json:
            type: object
            properties:
              type?: string
              fee?: number
              consent_privacy?: boolean
              consent_accuracy?: boolean
              consent_statutes?: boolean
              consent_finances?: boolean
        responses:
          200:
            description: Application submitted
    /approve:
      post:
        description: Approve membership application (Admin only)
        body:
          application/json:
            type: object
            properties:
              begin_date:
                type: integer
                required: false
                description: Official start date (Unix timestamp)
        responses:
          200:
            description: Membership approved
    /deny:
      post:
        description: Deny membership application (Admin only)
        responses:
          200:
            description: Membership denied
    /cancel:
      post:
        description: Cancel or reset membership
        responses:
          200:
            description: Membership cancelled/reset
    /documents:
      post:
        description: Upload a document for the club
        body:
          multipart/form-data:
            properties:
              document:
                type: file
                description: The document to upload
        responses:
          200:
            description: Document uploaded successfully
            body:
              application/json:
                type: object
                properties:
                  message: string
                  filename: string
      get:
        description: List documents for the club
        securedBy: [ basicAuth ]
        responses:
          200:
            description: List of documents
            body:
              application/json:
                type: array # object[]
      /{filename}:
        get:
          description: Download a specific document
          securedBy: [ basicAuth ]
          responses:
            200:
              description: Document file
        delete:
          description: Delete a specific document (Admin or Owner in non-active states)
          securedBy: [ basicAuth ]
          responses:
            204:
              description: Document deleted
    /download-documents:
      get:
        description: Download all documents as ZIP
        securedBy: [ basicAuth ]
        responses:
          200:
            description: ZIP file containing all documents
            body:
              application/zip:
    /payment-details:
      get:
        description: Get SEPA/Payment details for the club
        securedBy: [ basicAuth ]
        responses:
          200:
            description: Payment details
            body:
              application/json:
                type: object
    /owners:
      post:
        description: Add an owner to the club
        securedBy: [ basicAuth ]
        body:
          application/json:
            type: object
            properties:
              email: string
              authorizedRepresentative:
                type: boolean
                required: false
        responses:
          200:
            description: Owner added
      /{userKey}:
        delete:
          description: Remove an owner from the club
          securedBy: [ basicAuth ]
          responses:
            204:
              description: Owner removed

    /census/{year}:
      get:
        description: Get census data for a specific year
        securedBy: [ basicAuth ]
        responses:
          200:
            description: Census data
            body:
              application/json:
                type: Census
      put:
        description: Upload census data (CSV)
        securedBy: [ basicAuth ]
        body:
          multipart/form-data:
             properties:
               file:
                 type: file
        responses:
          200:
            description: Census data uploaded

/census/sample:
  get:
    description: Download sample CSV for census
    responses:
      200:
        description: CSV sample
        body:
          text/csv:

/audit:
  securedBy: [ basicAuth ]
  get:
    description: Get a list of recent audit log entries (Admin only)
    queryParameters:
      user?:
        type: string
        description: Filter by user making the action
      target?:
        type: string
        description: Filter by generic target
      action?:
        type: string
        description: Filter by specific action type
      limit?:
        type: integer
        default: 100
        description: Limit number of results
    responses:
      200:
        description: Successful retrieval of audit logs
        body:
          application/json:
            type: array

/version:
  get:
    description: Returns the version of the API - the only endpoint that does not use JSON-formatted response, i.e. no quotes around version string
    responses:
      '200':
        description: OK
        body:
          type: string
          example: "42"