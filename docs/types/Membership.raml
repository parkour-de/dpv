#%RAML 1.0 DataType
type: object
properties:
  iban?:
    type: string
    example: "DE12345678901234567890"
  sepa_mandate_number?:
    type: string
    example: "DPV-12345"
  contribution:
    type: number
    example: 120.50
  status:
    type: string
    enum: [inactive, requested, active, denied, cancelled]
    example: "inactive"
  type?:
    type: string
    example: "active"
  fee?:
    type: number
    example: 24.50
  address?:
    type: string
    example: "Musterstraße 1, 12345 Musterstadt"
  application_date?:
    type: integer
    description: Unix timestamp of membership application
    example: 1704067200
  begin_date?:
    type: integer
    description: Unix timestamp of membership start
    example: 1704067200
  end_date?:
    type: integer
    description: Unix timestamp of membership end
    example: 1735689600
  membership_number?:
    type: string
  current_fee?:
    type: number
  current_votes?:
    type: integer
